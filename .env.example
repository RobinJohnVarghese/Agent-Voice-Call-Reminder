# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public HTTPS URL that Plivo can reach (use ngrok/cloudflared in development)
PUBLIC_BASE_URL=https://your-public-host.example.com

# ---- Database / queue ----
DATABASE_URL=postgresql+psycopg://voice:voice@localhost:5432/voice_reminder
REDIS_URL=redis://localhost:6379/0

# ---- Google Gemini TTS ----
TTS_PROVIDER=gemini            # gemini | fake (fake = beep tone, for local testing)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_DEFAULT_VOICE=Kore
AUDIO_FORMAT=mp3               # mp3 (needs ffmpeg) | wav

# ---- Audio storage ----
STORAGE_BACKEND=s3             # s3 | gcs | local
STORAGE_PREFIX=voice-reminders
SIGNED_URL_EXPIRY_SECONDS=3600
# S3 (credentials via the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role)
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=             # for S3-compatible storage (MinIO, R2, ...)
# S3_PUBLIC_BASE_URL=          # e.g. CloudFront URL; otherwise presigned URLs are used
# GCS (credentials via GOOGLE_APPLICATION_CREDENTIALS service-account JSON)
GCS_BUCKET=
# GCS_PUBLIC_BASE_URL=
# Local disk (served at PUBLIC_BASE_URL/media)
LOCAL_MEDIA_DIR=media

# ---- Plivo ----
TELEPHONY_PROVIDER=plivo       # plivo | fake (fake = simulated calls)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=             # your Plivo number in E.164, e.g. +918035737XXX
PLIVO_VALIDATE_SIGNATURE=true
RING_TIMEOUT_SECONDS=30
CALL_TIME_LIMIT_SECONDS=300
FAKE_CALL_OUTCOME=random       # completed | no-answer | busy | failed | random
FAKE_CALL_DELAY_SECONDS=3

# ---- Batching / retries ----
CALL_BATCH_SIZE=20
CALL_BATCH_INTERVAL_SECONDS=10
CALLS_PER_SECOND=2
MAX_CALL_ATTEMPTS=3
RETRY_DELAY_SECONDS=900
RETRY_ON_STATUSES=no_answer,busy
STALE_CALL_TIMEOUT_MINUTES=30

# ---- Recipient import ----
DEFAULT_COUNTRY_CODE=IN
MAX_UPLOAD_ROWS=10000
MAX_UPLOAD_MB=10
